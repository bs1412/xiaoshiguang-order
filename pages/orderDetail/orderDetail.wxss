.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  background: linear-gradient(135deg, #ff8a4c, #ff6b35);
  border-radius: 20rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.status-icon {
  font-size: 80rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 16rpx;
}

.status-time {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}

.section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  color: #555555;
  font-size: 28rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  color: #555555;
  font-size: 28rpx;
}

.total-row {
  border-top: 1rpx solid #f2f2f2;
  margin-top: 8rpx;
  padding-top: 20rpx;
  color: #333333;
  font-weight: bold;
}

.total-price {
  color: #ff6b35;
  font-size: 34rpx;
}

.again-btn {
  background: #ff6b35;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 80rpx;
}

.not-found {
  text-align: center;
  color: #999999;
  padding-top: 200rpx;
}
