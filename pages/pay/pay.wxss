.page {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.pay-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  color: #555555;
  font-size: 28rpx;
}

.pay-price {
  color: #333333;
}

.method {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.method:last-child {
  border-bottom: none;
}

.method-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.method-name {
  flex: 1;
  font-size: 30rpx;
}

.method-check {
  color: #ff6b35;
  font-size: 34rpx;
  font-weight: bold;
}

.pay-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.total-price {
  color: #ff6b35;
  font-size: 38rpx;
  font-weight: bold;
}

.pay-btn {
  background: #ff6b35;
  color: #ffffff;
  font-size: 30rpx;
  padding: 0 64rpx;
  line-height: 76rpx;
}

.tip {
  text-align: center;
  color: #bbbbbb;
  font-size: 24rpx;
  margin-top: 12rpx;
}
