<view class="page">
  <view class="section">
    <view class="section-title">订单明细</view>
    <view class="pay-item" wx:for="{{cart}}" wx:key="id">
      <text class="pay-name">{{item.emoji}} {{item.name}} × {{item.count}}</text>
      <text class="pay-price">¥{{item.price * item.count}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">支付方式</view>
    <view class="method {{method === 'wechat' ? 'selected' : ''}}" data-method="wechat" bindtap="selectMethod">
      <text class="method-icon">💚</text>
      <text class="method-name">微信支付</text>
      <text class="method-check">{{method === 'wechat' ? '✓' : ''}}</text>
    </view>
    <view class="method {{method === 'balance' ? 'selected' : ''}}" data-method="balance" bindtap="selectMethod">
      <text class="method-icon">💰</text>
      <text class="method-name">余额支付（模拟）</text>
      <text class="method-check">{{method === 'balance' ? '✓' : ''}}</text>
    </view>
  </view>

  <view class="pay-footer">
    <view class="total">需支付：<text class="total-price">¥{{total}}</text></view>
    <button class="pay-btn" bindtap="pay">立即支付</button>
  </view>

  <view class="tip">演示版为模拟支付，不会产生真实扣款</view>
</view>
