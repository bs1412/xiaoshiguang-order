<view class="page">
  <view wx:if="{{cart.length === 0}}" class="empty">
    <view class="empty-icon">🛒</view>
    <view class="empty-text">购物车还是空的</view>
    <button class="empty-btn" bindtap="goOrder">去点餐</button>
  </view>

  <block wx:else>
    <view class="cart-list">
      <view class="cart-item" wx:for="{{cart}}" wx:key="id">
        <view class="cart-emoji">{{item.emoji}}</view>
        <view class="cart-info">
          <view class="cart-name">{{item.name}}</view>
          <view class="cart-price">¥{{item.price}}</view>
        </view>
        <view class="stepper">
          <view class="step-btn" data-id="{{item.id}}" bindtap="minus">−</view>
          <text class="step-num">{{item.count}}</text>
          <view class="step-btn" data-id="{{item.id}}" bindtap="plus">+</view>
        </view>
      </view>
    </view>

    <view class="cart-footer">
      <view class="total">合计：<text class="total-price">¥{{total}}</text></view>
      <button class="checkout-btn" bindtap="checkout">去结算</button>
    </view>
  </block>
</view>
