.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 20rpx;
  color: #999999;
}

.empty-btn {
  margin-top: 40rpx;
  background: #ff6b35;
  color: #ffffff;
  font-size: 28rpx;
  padding: 0 80rpx;
}

.cart-list {
  padding: 24rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.cart-emoji {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.cart-info {
  flex: 1;
}

.cart-name {
  font-size: 30rpx;
  font-weight: bold;
}

.cart-price {
  color: #ff6b35;
  font-size: 28rpx;
  margin-top: 8rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #f3f3f3;
  color: #333333;
  font-size: 34rpx;
}

.step-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 30rpx;
}

.cart-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.total {
  font-size: 28rpx;
}

.total-price {
  color: #ff6b35;
  font-size: 38rpx;
  font-weight: bold;
}

.checkout-btn {
  background: #ff6b35;
  color: #ffffff;
  font-size: 30rpx;
  padding: 0 56rpx;
  line-height: 76rpx;
}
